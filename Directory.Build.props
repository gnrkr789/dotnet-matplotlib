<Project>

  <!--
    Shared MSBuild properties for every project in dotnet-matplotlib.
    The library is written in F# targeting the latest .NET 10 LTS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- F# project output should be reproducible & analyzable; keep signatures tidy. -->
    <OtherFlags>$(OtherFlags) --nowarn:3511</OtherFlags>
  </PropertyGroup>

  <!-- Shared package/authoring metadata -->
  <PropertyGroup>
    <Authors>dotnet-matplotlib contributors</Authors>
    <Product>dotnet-matplotlib</Product>
    <Company>dotnet-matplotlib</Company>
    <RepositoryUrl>https://github.com/gnrkr789/dotnet-matplotlib</RepositoryUrl>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 dotnet-matplotlib contributors.</Copyright>
  </PropertyGroup>

</Project>
