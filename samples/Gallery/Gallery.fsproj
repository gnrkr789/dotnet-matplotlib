<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Matplotlib.Samples.Gallery</RootNamespace>
    <AssemblyName>Gallery</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Matplotlib\Matplotlib.fsproj" />
    <!-- Matplotlib bundles Domain/Backends privately, so reference Domain directly. -->
    <ProjectReference Include="..\..\src\Matplotlib.Domain\Matplotlib.Domain.fsproj" />
  </ItemGroup>

</Project>
