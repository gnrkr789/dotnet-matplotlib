<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only interactive demo; not part of the solution / CI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Matplotlib.Samples.GuiDemo</RootNamespace>
    <AssemblyName>GuiDemo</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Matplotlib\Matplotlib.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.Domain\Matplotlib.Domain.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.Gui\Matplotlib.Gui.fsproj" />
  </ItemGroup>

</Project>
