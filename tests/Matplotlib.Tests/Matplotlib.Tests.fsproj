<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Matplotlib.Tests</RootNamespace>
    <AssemblyName>Matplotlib.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="PrimitiveTests.fs" />
    <Compile Include="TransformTests.fs" />
    <Compile Include="ColorTests.fs" />
    <Compile Include="TickingTests.fs" />
    <Compile Include="PatchTests.fs" />
    <Compile Include="StepErrorbarTests.fs" />
    <Compile Include="TickStyleTests.fs" />
    <Compile Include="MarkerLegendTests.fs" />
    <Compile Include="TextAnnotateTests.fs" />
    <Compile Include="CollectionLayoutTests.fs" />
    <Compile Include="LogScaleTests.fs" />
    <Compile Include="ColormapImageTests.fs" />
    <Compile Include="MeshContourTests.fs" />
    <Compile Include="CategoryDateTests.fs" />
    <Compile Include="SubplotTests.fs" />
    <Compile Include="RenderingTests.fs" />
    <Compile Include="RasterTests.fs" />
    <Compile Include="TrueTypeTests.fs" />
    <Compile Include="PdfTests.fs" />
    <Compile Include="HatchClipTests.fs" />
    <Compile Include="Phase5PlotsTests.fs" />
    <Compile Include="StyleSheetTests.fs" />
    <Compile Include="Axes3DTests.fs" />
    <Compile Include="AnimationTests.fs" />
    <Compile Include="NotebookTests.fs" />
    <Compile Include="McpToolsTests.fs" />
    <Compile Include="DataFrameTests.fs" />
    <Compile Include="ReportTests.fs" />
    <Compile Include="TableTests.fs" />
    <Compile Include="VersoTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Matplotlib\Matplotlib.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.Domain\Matplotlib.Domain.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.Backends\Matplotlib.Backends.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.Interactive\Matplotlib.Interactive.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.Mcp\Matplotlib.Mcp.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.DataFrame\Matplotlib.DataFrame.fsproj" />
    <ProjectReference Include="..\..\src\Matplotlib.Reports\Matplotlib.Reports.fsproj" />
  </ItemGroup>

</Project>
