<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Matplotlib.Reports</RootNamespace>
    <AssemblyName>Matplotlib.Reports</AssemblyName>
    <PackageId>DotnetMatplotlib.Reports</PackageId>
    <Description>A deterministic, dependency-free server-side reporting engine for DotnetMatplotlib: compose multi-panel SVG/PNG/PDF reports that run in serverless / Linux / Native AOT with byte-reproducible output for audit and compliance.</Description>
    <PackageTags>matplotlib;reporting;pdf;charts;serverless;deterministic;compliance;fsharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Report.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Becomes a package dependency on DotnetMatplotlib. -->
    <ProjectReference Include="..\Matplotlib\Matplotlib.fsproj" />
    <!-- Compile-time only: these ship inside the DotnetMatplotlib package's lib. -->
    <ProjectReference Include="..\Matplotlib.Domain\Matplotlib.Domain.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Matplotlib.Backends\Matplotlib.Backends.fsproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
