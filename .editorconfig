root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
end_of_line = lf

[*.{fs,fsi,fsx}]
indent_size = 4
max_line_length = 120
# Fantomas formatting options (https://fsprojects.github.io/fantomas/docs/)
fsharp_max_value_binding_width = 120
fsharp_max_function_binding_width = 120
fsharp_multiline_bracket_style = aligned

[*.{csproj,fsproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
